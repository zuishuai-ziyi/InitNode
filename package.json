{
  "name": "@zuishuai-ziyi/initnode",
  "version": "0.3.0",
  "description": "新云服务器初始化 CLI：生成/上传 SSH 密钥、注册 Komari 监控（自动发现）、清理云厂商监控代理、跑 NodeQuality 质量检测",
  "type": "module",
  "main": "index.js",
  "bin": {
    "initnode": "index.js"
  },
  "files": [
    "index.js",
    "src/"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node test/unit.mjs && node test/e2e.mjs",
    "publish:dry": "npm publish --dry-run",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuishuai-ziyi/InitNode.git"
  },
  "homepage": "https://github.com/zuishuai-ziyi/InitNode#readme",
  "bugs": {
    "url": "https://github.com/zuishuai-ziyi/InitNode/issues"
  },
  "keywords": [
    "ssh",
    "vps",
    "cloud",
    "init",
    "komari",
    "cli"
  ],
  "author": "zuishuai-ziyi"
}
